# RailYatri — Environment Configuration
# Copy this file to .env and fill in your values.
# The system runs fully without a database (in-memory/file fallback).

# ---------------------------------------------------------------------------
# PostgreSQL (optional — system works without it)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/railyatri

# DDL (for reference — auto-applied by DatabaseManager on first connection):
#
# CREATE TABLE interactions (
#     id              SERIAL PRIMARY KEY,
#     user_id         TEXT        NOT NULL,
#     query_hash      TEXT        NOT NULL,
#     user_query      TEXT        NOT NULL,
#     is_safe         BOOLEAN,
#     attack_type     TEXT,
#     intents         JSONB,
#     plan            JSONB,
#     tool_results    JSONB,
#     final_response  TEXT,
#     created_at      TIMESTAMPTZ DEFAULT NOW()
# );
#
# CREATE TABLE train_search_cache (
#     id              SERIAL PRIMARY KEY,
#     cache_key       TEXT        NOT NULL UNIQUE,
#     origin          TEXT        NOT NULL,
#     destination     TEXT        NOT NULL,
#     travel_date     TEXT        NOT NULL,
#     result          JSONB       NOT NULL,
#     created_at      TIMESTAMPTZ DEFAULT NOW()
# );

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# File-based interaction log (used when PostgreSQL is unavailable)
INTERACTION_LOG_FILE=logs/interactions.jsonl

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=8000

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# LLM — Groq API (OpenAI-compatible)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
